<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg_translucent"
    android:padding="22dp"
    android:elevation="16dp">

    <!-- Header with Icon & Version -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/circle_cyan"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Update Available"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/textDialogVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live WaterPaper v1.0.1"
                android:textSize="13sp"
                android:textColor="#0284C7"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#15000000"
        android:layout_marginBottom="12dp" />

    <!-- Release Notes Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="What's New:"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#64748B"
        android:layout_marginBottom="6dp" />

    <!-- Scrollable Release Notes -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#0A000000"
        android:padding="10dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/textDialogNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Enhanced fluid simulation\n• Automatic update engine\n• Stability improvements"
            android:textSize="13sp"
            android:textColor="#334155"
            android:lineSpacingExtra="3dp" />
    </ScrollView>

    <!-- Progress Container (Visible during download) -->
    <LinearLayout
        android:id="@+id/containerDownloadProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginBottom="14dp">

        <ProgressBar
            android:id="@+id/progressDownload"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#00B4D8"
            android:progressBackgroundTint="#E2E8F0"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/textDownloadStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Downloading... 0%"
            android:textSize="12sp"
            android:textColor="#64748B"
            android:gravity="center" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnDialogLater"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Later"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:background="@drawable/btn_secondary_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btnDialogAction"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="UPDATE NOW"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_primary_bg"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />
    </LinearLayout>

</LinearLayout>

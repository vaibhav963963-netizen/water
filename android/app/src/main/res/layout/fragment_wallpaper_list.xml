<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollWallpaperList"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:background="@color/bg_canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="46dp"
        android:paddingBottom="100dp">

        <!-- Header: Back Button, Title, Subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="22dp">

            <ImageView
                android:id="@+id/btnWallpaperListBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/btn_icon_circle"
                android:src="@drawable/ic_back_arrow"
                android:padding="10dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Back to Home" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live Wallpapers"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_display" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose or customize interactive wallpapers"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="1dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GALLERY &amp; PREVIEWS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/brand_warm_grey"
            android:letterSpacing="0.08"
            android:layout_marginBottom="14dp" />

        <!-- 2-Side-By-Side Grid: Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="18dp">

            <!-- Item 1: Liquid Fluid Wallpaper (Mobile Phone Frame) -->
            <LinearLayout
                android:id="@+id/cardWallpaperCatalogItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_clean_white"
                android:padding="12dp"
                android:layout_marginEnd="7dp"
                android:clickable="true"
                android:focusable="true">

                <!-- Realistic Mobile Phone Frame -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="@drawable/phone_mockup_outer"
                    android:padding="5dp">

                    <!-- Phone Inner Screen Display -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/phone_mockup_screen">

                        <!-- Wallpaper Visual Preview Artwork -->
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/wallpaper_thumb"
                            android:scaleType="centerCrop"
                            android:contentDescription="Fluid Preview" />

                        <!-- Water Drop 3D Icon Overlay -->
                        <ImageView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:src="@drawable/sticker_water_drop_3d"
                            android:layout_gravity="center"
                            android:contentDescription="Water Drop Icon" />

                        <!-- Camera Punch Hole / Dynamic Island -->
                        <View
                            android:layout_width="32dp"
                            android:layout_height="8dp"
                            android:background="@drawable/phone_island_notch"
                            android:layout_gravity="top|center_horizontal"
                            android:layout_marginTop="6dp" />

                        <!-- Top Pill Badge -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACTIVE"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_milano_red"
                            android:background="@drawable/pill_badge_cream"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="8dp" />
                    </FrameLayout>
                </FrameLayout>

                <!-- Title & Meta -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Liquid Fluid"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_display"
                    android:layout_marginTop="10dp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Interactive 2D Navier-Stokes"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Action Button -->
                <Button
                    android:id="@+id/btnViewWallpaper"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="Preview →"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_lemon_chiffon"
                    android:background="@drawable/btn_primary_red"
                    android:layout_marginTop="8dp"
                    android:padding="0dp" />
            </LinearLayout>

            <!-- Item 2: Floating Sticks Wallpaper (Mobile Phone Frame) -->
            <LinearLayout
                android:id="@+id/cardWallpaperSticksItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_clean_white"
                android:padding="12dp"
                android:layout_marginStart="7dp"
                android:clickable="true"
                android:focusable="true">

                <!-- Realistic Mobile Phone Frame -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="@drawable/phone_mockup_outer"
                    android:padding="5dp">

                    <!-- Phone Inner Screen Display -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/phone_mockup_screen">

                        <!-- Wallpaper Visual Preview Artwork -->
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/wallpaper_thumb"
                            android:scaleType="centerCrop"
                            android:contentDescription="Sticks Preview" />

                        <!-- 3D Driftwood Twig Overlay -->
                        <ImageView
                            android:layout_width="100dp"
                            android:layout_height="40dp"
                            android:src="@drawable/stick_twig_1"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:rotation="-10"
                            android:contentDescription="Floating Stick Preview" />

                        <!-- Camera Punch Hole / Dynamic Island -->
                        <View
                            android:layout_width="32dp"
                            android:layout_height="8dp"
                            android:background="@drawable/phone_island_notch"
                            android:layout_gravity="top|center_horizontal"
                            android:layout_marginTop="6dp" />

                        <!-- Top Pill Badge -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3D RIGID"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_milano_red"
                            android:background="@drawable/pill_badge_cream"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="8dp" />
                    </FrameLayout>
                </FrameLayout>

                <!-- Title & Meta -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Floating Sticks"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_display"
                    android:layout_marginTop="10dp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wood Physics &amp; Buoyancy"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Action Button -->
                <Button
                    android:id="@+id/btnViewSticksWallpaper"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:text="Preview →"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_lemon_chiffon"
                    android:background="@drawable/btn_primary_red"
                    android:layout_marginTop="8dp"
                    android:padding="0dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- More Wallpapers Placeholder Row (for future additions) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/card_module_soft_cream"
            android:padding="16dp"
            android:layout_marginTop="6dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/sticker_toolbox_3d"
                android:layout_marginEnd="10dp"
                android:contentDescription="Toolbox" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="More physics wallpapers coming soon in upcoming updates"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

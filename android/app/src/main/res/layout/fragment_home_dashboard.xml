<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollHomeDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:background="@color/bg_canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="50dp"
        android:paddingBottom="100dp">

        <!-- Header: Logo, App Name, "Your Space", Settings Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="32dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/sticker_water_drop_3d"
                android:layout_marginEnd="12dp"
                android:contentDescription="Live WaterPaper Logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live WaterPaper"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_milano_red"
                    android:letterSpacing="0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Space"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_display"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <!-- Small Settings Button -->
            <ImageView
                android:id="@+id/btnHeaderSettings"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/btn_icon_circle"
                android:src="@drawable/ic_header_settings"
                android:padding="10dp"
                android:contentDescription="Settings" />
        </LinearLayout>

        <!-- Section Title: "MY MODULES" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MY MODULES"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/brand_warm_grey"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 Modules"
                android:textSize="11sp"
                android:textColor="@color/brand_milano_red"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Two-Column Grid: Row 1 (Modules 1 & 2) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="14dp">

            <!-- MODULE 1: WALLPAPER (ACTIVE) -->
            <!-- Milano Red Background with Lemon Chiffon Text -->
            <LinearLayout
                android:id="@+id/moduleCardWallpaper"
                android:layout_width="0dp"
                android:layout_height="176dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_module_red"
                android:padding="16dp"
                android:layout_marginEnd="7dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/sticker_water_drop_3d"
                        android:contentDescription="Wallpaper Illustration" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTIVE"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_milano_red"
                        android:background="@drawable/pill_badge_cream"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wallpaper"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_lemon_chiffon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="Explore your live wallpaper"
                    android:textSize="12sp"
                    android:textColor="#E6FFFBD4"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Explore →"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_lemon_chiffon" />
            </LinearLayout>

            <!-- MODULE 2: PERSONAL NOTES (COMING SOON) -->
            <!-- Lemon Chiffon Background with Milano Red and Charcoal Accents -->
            <LinearLayout
                android:id="@+id/moduleCardNotes"
                android:layout_width="0dp"
                android:layout_height="176dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_module_cream"
                android:padding="16dp"
                android:layout_marginStart="7dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/sticker_notebook_3d"
                        android:contentDescription="Notes Illustration" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SOON"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_milano_red"
                        android:background="@drawable/pill_badge_cream"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personal Notes"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="Your thoughts, all in one place"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Details →"
                    android:textSize="12sp"
                    android:textColor="@color/brand_milano_red"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Two-Column Grid: Row 2 (Modules 3 & 4) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="14dp">

            <!-- MODULE 3: FAVOURITE PHOTOS (COMING SOON) -->
            <!-- Warm White Background with Charcoal Typography & Muted Gold Accents -->
            <LinearLayout
                android:id="@+id/moduleCardPhotos"
                android:layout_width="0dp"
                android:layout_height="176dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_module_white"
                android:padding="16dp"
                android:layout_marginEnd="7dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/sticker_camera_3d"
                        android:contentDescription="Photos Illustration" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SOON"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_muted_gold"
                        android:background="@drawable/pill_badge_gold"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Favourite Photos"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="Keep your memories together"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Details →"
                    android:textSize="12sp"
                    android:textColor="@color/brand_muted_gold"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- MODULE 4: PERSONAL COLLECTIONS (COMING SOON) -->
            <!-- Deep Charcoal Background with Lemon Chiffon Typography & Gold Details -->
            <LinearLayout
                android:id="@+id/moduleCardCollections"
                android:layout_width="0dp"
                android:layout_height="176dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/card_module_charcoal"
                android:padding="16dp"
                android:layout_marginStart="7dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/sticker_folder_3d"
                        android:contentDescription="Collections Illustration" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SOON"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_champagne_gold"
                        android:background="@drawable/pill_badge_gold"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Collections"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_lemon_chiffon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="Organize your personal things"
                    android:textSize="12sp"
                    android:textColor="@color/brand_champagne_gold"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Details →"
                    android:textSize="12sp"
                    android:textColor="@color/brand_champagne_gold"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- MODULE 5: MORE TOOLS (Row 3, Full Width Compact) -->
        <!-- Soft Cream Background with Deep Black Typography & Milano Red Icon Accents -->
        <LinearLayout
            android:id="@+id/moduleCardTools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_module_soft_cream"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/sticker_toolbox_3d"
                android:layout_marginEnd="14dp"
                android:contentDescription="Tools Illustration" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="More Tools"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_display" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="More useful features coming soon"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SOON"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/brand_milano_red"
                android:background="@drawable/pill_badge_cream"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

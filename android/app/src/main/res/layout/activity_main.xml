<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas">

    <!-- Subtle Ambient Particle Accents in Background -->
    <com.waterlivewallpaper.ui.FloatingParticlesView
        android:id="@+id/floatingParticlesView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.25" />

    <!-- Fragment Host Container for Screen Navigation -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Refined Minimal Floating Bottom Navigation Bar -->
    <!-- Visible on: HomeDashboardFragment, WallpaperListFragment, SettingsFragment -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="22dp"
        android:background="@drawable/nav_bar_surface"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="4dp"
        android:weightSum="3"
        android:elevation="8dp">

        <!-- TAB 1: HOME DASHBOARD -->
        <LinearLayout
            android:id="@+id/navTabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navIconHome"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/brand_milano_red"
                android:contentDescription="Home Hub" />

            <TextView
                android:id="@+id/navTextHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/brand_milano_red"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- TAB 2: WALLPAPERS LISTING -->
        <LinearLayout
            android:id="@+id/navTabWallpaper"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navIconWallpaper"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_wallpaper"
                app:tint="@color/brand_charcoal"
                android:contentDescription="Wallpapers" />

            <TextView
                android:id="@+id/navTextWallpaper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wallpaper"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/brand_warm_grey"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- TAB 3: SETTINGS -->
        <LinearLayout
            android:id="@+id/navTabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/navIconSettings"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_settings"
                app:tint="@color/brand_charcoal"
                android:contentDescription="Settings" />

            <TextView
                android:id="@+id/navTextSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/brand_warm_grey"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Custom In-App Toast Banner with Milano Red & Lemon Chiffon Theme -->
    <LinearLayout
        android:id="@+id/toastBannerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/card_module_charcoal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:elevation="16dp">

        <ImageView
            android:id="@+id/toastIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/sticker_water_drop_3d"
            android:layout_marginEnd="12dp"
            android:contentDescription="Toast Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/toastTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notification"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/brand_lemon_chiffon" />

            <TextView
                android:id="@+id/toastSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Details"
                android:textSize="11sp"
                android:textColor="@color/brand_champagne_gold"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
